{
    "name": "model-portfolio",
    "version": "1.0.0",
    "description": "",
    "private": true,
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0 <21.0.0",
        "npm": ">=10.8.2 <11.0.0"
    },
    "packageManager": ">=npm@10.8.2 < 11.0.0",
    "repository": {
        "type": "git",
        "url": ""
    },
    "author": "Ahamed Abbas",
    "scripts": {
        "start": "npm run start:ui & npm run start:server",
        "start:ui": "vite dev --config ./vite/ui/vite.dev.ts",
        "start:server": "nodemon --quiet --watch \"server.src/**\" --ext ts --exec \"node --experimental-specifier-resolution=node --loader ./ts-node.loader.js  server.dev.ts\"",
        "build": "npm run build:server & npm run build:ui",
        "build:ui": "vite build --config ./vite/ui/vite.prod.ts",
        "build:server": "babel server.src --extensions '.ts,.js' --out-dir build/server --config-file ./babel.config.js --verbose --ignore \"node_modules\"",
        "lint": "eslint src server.src vite",
        "lint:fix": "eslint src server.src vite --fix",
        "test": "vitest run --config ./vitest.config.ts",
        "test:watch": "vitest watch --config ./vitest.config.ts",
        "tsc": "tsc --project ./tsconfig.json",
        "docker": "cross-env NODE_ENV=production node --import=specifier-resolution-node/register build/server/index.js"
    },
    "dependencies": {
        "@apollo/client": "^3.13.1",
        "@apollo/server": "^4.11.3",
        "axios": "^1.7.9",
        "core-js": "^3.40.0",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "express": "^4.21.2",
        "graphql": "^16.10.0",
        "morgan": "^1.10.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router": "^7.1.2",
        "uuid": "^11.0.5",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.26.4",
        "@babel/core": "^7.26.0",
        "@babel/plugin-transform-runtime": "^7.26.8",
        "@babel/preset-env": "^7.26.0",
        "@babel/preset-typescript": "^7.26.0",
        "@babel/register": "^7.25.9",
        "@stylistic/eslint-plugin": "^2.13.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@types/babel__register": "^7.17.3",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.10.7",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "@typescript-eslint/eslint-plugin": "^8.20.0",
        "@typescript-eslint/parser": "^8.20.0",
        "@vitejs/plugin-legacy": "^6.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/eslint-plugin": "^1.1.25",
        "babel-plugin-module-resolver": "^5.0.2",
        "eslint": "^9.18.0",
        "eslint-import-resolver-typescript": "^3.7.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.11.0",
        "eslint-plugin-newline-destructuring": "^1.2.2",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-unused-imports": "^4.1.4",
        "jiti": "^2.4.2",
        "jsdom": "^26.0.0",
        "nodemon": "^3.1.9",
        "specifier-resolution-node": "^1.1.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.0.7",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.0.1"
    }
}
